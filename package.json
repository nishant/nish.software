{
  "name": "nish.software",
  "private": true,
  "version": "1.0.0",
  "description": "nish.software - app hub, projects and resume. Static site, no runtime dependencies.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "fold:serve": "node scripts/fold-serve.mjs",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@nish/ui": "https://codeload.github.com/nishant/ui/tar.gz/refs/tags/v1.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
